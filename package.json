{
  "name": "runway-dev-plugin-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build:plugin": "node scripts/build-dev-plugin.ts",
    "test": "node --test tests/*.test.ts",
    "check": "biome check scripts tests package.json tsconfig.json biome.json",
    "format": "biome format --write scripts tests package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.19.1",
    "adm-zip": "0.6.1",
    "typescript": "7.0.2"
  }
}
